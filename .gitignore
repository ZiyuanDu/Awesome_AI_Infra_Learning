# Only publish source code, Markdown, and project manifests.
*
!*/
!.gitignore
!*.cu
!*.cuh
!*.c
!*.cc
!*.cpp
!*.h
!*.hpp
!*.py
!*.sh
!*.md
!*.mdx
!CMakeLists.txt
!*.cmake
!Makefile
!requirements*.txt
!pyproject.toml
!uv.lock
!LICENSE
!LICENSE.*

# Keep blog illustrations in an assets/ directory.
!**/assets/**/*.png
!**/assets/**/*.jpg
!**/assets/**/*.jpeg
!**/assets/**/*.gif
!**/assets/**/*.webp
!**/assets/**/*.svg

# Exclude generated source files as well as compiled artifacts.
build/
cmake-build-*/
CMakeFiles/
dist/
*.egg-info/
.venv/
venv/
__pycache__/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
node_modules/
data/
datasets/
models/
checkpoints/
results/
profile/

# Existing local-only notes and comparisons.
草稿.md
**/compare.cu
